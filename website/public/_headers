/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000

/media/*
  Cache-Control: public, max-age=604800

# no-transform stops Cloudflare adding its analytics beacon to the pages.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/privacy/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/support/
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/download/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Robots-Tag: noindex

/mac/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Robots-Tag: noindex

/mac/developers/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Robots-Tag: noindex

# Supper, the demo site Browsa's agents practise on (the app ships the same files).
/demo/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
  X-Robots-Tag: noindex

/demo/img/*
  Cache-Control: public, max-age=604800
