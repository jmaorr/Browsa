{
  "name": "browsa-website",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Mac releases: appcast.xml, Sparkle zips and deltas, and the DMGs, under mac/ (tools/publish-mac.sh).
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "browsa-releases" }],
  // Update checks and downloads, counted with no IP or ID (see count() in src/index.js).
  "analytics_engine_datasets": [{ "binding": "USAGE", "dataset": "browsa_usage" }],
  // PostHog project for the usage dashboard. The token is a secret: wrangler secret put POSTHOG_TOKEN.
  "vars": { "POSTHOG_HOST": "https://us.i.posthog.com" },
  "routes": [
    { "pattern": "browsa.app", "custom_domain": true },
    { "pattern": "www.browsa.app", "custom_domain": true }
  ],
  "observability": { "enabled": false }
}
