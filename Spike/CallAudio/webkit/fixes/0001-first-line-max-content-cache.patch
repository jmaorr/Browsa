diff --git a/LayoutTests/fast/inline/first-line-style-change-with-cached-max-content-line-crash-expected.txt b/LayoutTests/fast/inline/first-line-style-change-with-cached-max-content-line-crash-expected.txt
new file mode 100644
index 0000000000..0265c166ec
--- /dev/null
+++ b/LayoutTests/fast/inline/first-line-style-change-with-cached-max-content-line-crash-expected.txt
@@ -0,0 +1,3 @@
+My services and account
+Bills and payments
+PASS: no crash
diff --git a/LayoutTests/fast/inline/first-line-style-change-with-cached-max-content-line-crash.html b/LayoutTests/fast/inline/first-line-style-change-with-cached-max-content-line-crash.html
new file mode 100644
index 0000000000..aaf0415ed6
--- /dev/null
+++ b/LayoutTests/fast/inline/first-line-style-change-with-cached-max-content-line-crash.html
@@ -0,0 +1,36 @@
+<!DOCTYPE html>
+<!-- Reduced from the logged-in My Telstra header (.mt-button__content:first-line inside flex buttons).
+     A repaint-only style change replaces the renderer's style, destroying its cached ::first-line style,
+     while the inline content cache still holds the max-content line built with it. The next intrinsic
+     width pass (flex min-content) drops that line and crashes on the dead style (CheckedPtr zombie). -->
+<style>
+  .nav { display: flex; width: 400px; }
+  .button { display: flex; align-items: center; color: black; }
+  .button .content::first-line { font-weight: 400; }
+  .nav .active .content::first-line { font-weight: 700; }
+  .wrap { display: block; }
+</style>
+<div class="nav">
+  <div class="wrap"><div class="wrap"><a class="button" id="b"><div class="content">My services and account</div></a></div></div>
+  <div class="wrap"><a class="button"><div class="content">Bills and payments</div></a></div>
+</div>
+<pre id="log"></pre>
+<script>
+if (window.testRunner) { testRunner.dumpAsText(); testRunner.waitUntilDone(); }
+const b = document.getElementById('b');
+const content = b.querySelector('.content');
+function step(i) {
+  document.body.offsetWidth;
+  // Repaint-only change: new style objects, the cached line content survives.
+  content.style.color = i % 2 ? 'red' : 'blue';
+  b.classList.toggle('active');
+  document.body.offsetWidth;
+  // Force intrinsic widths to be recomputed up the flex chain.
+  document.querySelector('.nav').style.width = (400 + i) + 'px';
+  b.parentNode.style.paddingLeft = (i % 3) + 'px';
+  document.body.offsetWidth;
+}
+for (let i = 0; i < 20; ++i) step(i);
+document.getElementById('log').textContent = 'PASS: no crash';
+if (window.testRunner) testRunner.notifyDone();
+</script>
diff --git a/Source/WebCore/layout/formattingContexts/inline/InlineFormattingContext.cpp b/Source/WebCore/layout/formattingContexts/inline/InlineFormattingContext.cpp
index bf03fdc795..c5116e46d6 100644
--- a/Source/WebCore/layout/formattingContexts/inline/InlineFormattingContext.cpp
+++ b/Source/WebCore/layout/formattingContexts/inline/InlineFormattingContext.cpp
@@ -82,6 +82,20 @@ NODELETE static std::optional<InlineItemRange> partialRangeForDamage(const Inlin
     return InlineItemRange { layoutStartPosition, { inlineItemList.size(), 0 } };
 }
 
+// The cached line outlives this layout. Its runs hold checked references to their styles. A box's own style lives as long as the box,
+// but a ::first-line style belongs to the renderer's computed style and is destroyed by any style change on the renderer, including
+// repaint-only ones that keep this cache. Releasing a line that still refers to such a dead style crashes (CheckedPtr zombie).
+static bool canCacheMaximumIntrinsicWidthLineContent(const std::optional<LineLayoutResult>& lineContent)
+{
+    if (!lineContent)
+        return false;
+    for (auto& run : lineContent->runs) {
+        if (!run.usesStyleOwnedByLayoutBox())
+            return false;
+    }
+    return true;
+}
+
 NODELETE static bool isEmptyInlineContent(const InlineItemList& inlineItemList)
 {
     if (inlineItemList.isEmpty())
@@ -217,7 +231,7 @@ std::pair<LayoutUnit, LayoutUnit> InlineFormattingContext::minimumMaximumContent
             minimumContentSize = intrinsicWidthHandler.minimumContentSize();
         if (!maximumContentSize) {
             maximumContentSize = intrinsicWidthHandler.maximumContentSize();
-            if (intrinsicWidthHandler.maximumIntrinsicWidthLineContent())
+            if (canCacheMaximumIntrinsicWidthLineContent(intrinsicWidthHandler.maximumIntrinsicWidthLineContent()))
                 inlineContentCache.setMaximumIntrinsicWidthLineContent(WTF::move(*intrinsicWidthHandler.maximumIntrinsicWidthLineContent()));
         }
     } else {
@@ -280,7 +294,7 @@ LayoutUnit InlineFormattingContext::maximumContentSize(InlineDamage* lineDamage)
         auto intrinsicWidthHandler = IntrinsicWidthHandler { *this, inlineItems };
 
         maximumContentSize = intrinsicWidthHandler.maximumContentSize();
-        if (intrinsicWidthHandler.maximumIntrinsicWidthLineContent())
+        if (canCacheMaximumIntrinsicWidthLineContent(intrinsicWidthHandler.maximumIntrinsicWidthLineContent()))
             inlineContentCache.setMaximumIntrinsicWidthLineContent(WTF::move(*intrinsicWidthHandler.maximumIntrinsicWidthLineContent()));
     }
     inlineContentCache.setMaximumContentSize(maximumContentSize);
diff --git a/Source/WebCore/layout/formattingContexts/inline/InlineLine.cpp b/Source/WebCore/layout/formattingContexts/inline/InlineLine.cpp
index f332270c49..d959d8560e 100644
--- a/Source/WebCore/layout/formattingContexts/inline/InlineLine.cpp
+++ b/Source/WebCore/layout/formattingContexts/inline/InlineLine.cpp
@@ -854,6 +854,14 @@ std::optional<LineRun::TrailingWhitespace::Type> LineRun::trailingWhitespaceType
     return { TrailingWhitespace::Type::Collapsed };
 }
 
+bool LineRun::usesStyleOwnedByLayoutBox() const
+{
+    if (!m_layoutBox)
+        return false;
+    // Atomic inline-level boxes carry their parent's style (see LineBuilder). The parent box outlives its children.
+    return m_style.ptr() == &m_layoutBox->style() || m_style.ptr() == &m_layoutBox->parent().style();
+}
+
 LineRun::LineRun(const InlineItem& inlineItem, const Style::ComputedStyle& style, InlineLayoutUnit logicalLeft, InlineLayoutUnit logicalWidth, InlineLayoutUnit textSpacingAdjustment)
     : m_layoutBox(&inlineItem.layoutBox())
     , m_style(style)
diff --git a/Source/WebCore/layout/formattingContexts/inline/InlineLineRun.h b/Source/WebCore/layout/formattingContexts/inline/InlineLineRun.h
index 289802caf6..202885898e 100644
--- a/Source/WebCore/layout/formattingContexts/inline/InlineLineRun.h
+++ b/Source/WebCore/layout/formattingContexts/inline/InlineLineRun.h
@@ -83,6 +83,8 @@ struct LineRun {
     static bool isContentfulOrHasDecoration(const LineRun&, const InlineFormattingContext&);
 
     const Box& layoutBox() const { return *m_layoutBox; }
+    // The style is the layout box's own or its parent's (not a ::first-line style, which lives in the renderer's style and dies with it).
+    NODELETE bool usesStyleOwnedByLayoutBox() const;
     struct Text {
         size_t start { 0 };
         size_t length { 0 };
